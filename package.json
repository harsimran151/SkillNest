{
  "name": "skill-share-hub",
  "version": "6.7",
  "private": true,
  "description": "MERN Stack - Skill Sharing Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080 & npm run dev --workspace=server",
    "client": "vite --host 0.0.0.0 --port 8080",
    "server": "npm run dev --workspace=server",
    "build": "vite build && npm run build --workspace=server",
    "start": "npm start --workspace=server",
    "lint": "eslint . && npm run lint --workspace=server"
  },
  "keywords": ["mern", "react", "mongodb", "express", "node"],
  "author": "",
  "license": "MIT"
}
